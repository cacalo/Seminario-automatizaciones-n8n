            {
              "id": "020e8023-4e64-4402-9ca5-4810588b50a7",
              "name": "plan",
              "value": "={{ (() => {\n  const catalogo = $('Catálogo planes').all().map((i) => i.json);\n  const codigo = $('Webhook').item.json.body.data.metadata.plan_code;\n  return catalogo.find((p) => p.plan_code === codigo) || null;\n})() }}",
              "type": "object"
            },
            {
              "id": "da01d3c2-3984-4b2f-a0cb-a360f8238b25",
              "name": "vence",
              "value": "={{ (() => {\n  const plan = $('Catálogo planes').all().map((i) => i.json).find((p) => p.plan_code === $('Webhook').first().json.body.data.metadata.plan_code);\n  if (!plan) return null;\n  const d = new Date($('Webhook').first().json.body.created_at);\n  d.setUTCDate(d.getUTCDate() + plan.duracion_dias);\n  return d.toISOString().slice(0, 10);\n})() }}",
