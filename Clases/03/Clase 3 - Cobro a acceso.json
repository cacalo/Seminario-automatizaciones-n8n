            {
              "id": "d56f8cc6-cf63-4c37-9f9f-f8b6a6ff0460",
              "name": "usuario",
              "value": "={{ (() => {\n  const padron = $('Padrón usuarios').all().map((i) => i.json);\n  const correo = ($('Webhook').item.json.body.data.payer.email || '').trim().toLowerCase();\n  return padron.find((u) => (u.email || '').trim().toLowerCase() === correo) || null;\n})() }}",
              "type": "object"
